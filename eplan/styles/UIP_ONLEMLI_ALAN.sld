			<Title>UIP_ONLEMLI_ALAN</Title>
			<FeatureTypeStyle>
				<Rule>
					<Name>0</Name>
					<Title>ONLEMLI_ALAN</Title>
					<MaxScaleDenominator>75000</MaxScaleDenominator>
					<PointSymbolizer uom="http://www.opengeospatial.org/se/units/metre">
						<Graphic>
							<Mark>
								<WellKnownName>ttf://UIP_10_2#0x0056</WellKnownName>
								<Fill>
									<CssParameter name="fill">#000000</CssParameter>
								</Fill>
								<Stroke>
									<CssParameter name="stroke-opacity">0</CssParameter>
									<CssParameter name="stroke">#000000</CssParameter>
									<CssParameter name="stroke-width">1</CssParameter>
								</Stroke>
							</Mark>
							<Size>15</Size>
						</Graphic>
					</PointSymbolizer>
					<LineSymbolizer uom="http://www.opengeospatial.org/se/units/metre">
						<Stroke>
							<GraphicStroke>
								<Graphic>
									<Mark>
										<!--WellKnownName>ttf://UIP_10_2#0x002f</WellKnownName-->
										<WellKnownName>ttf://Intelli Eplan Extra#0x0041</WellKnownName>
										<Fill>
											<CssParameter name="fill">#FF0000</CssParameter>
										</Fill>
										<Stroke>
											<CssParameter name="stroke-opacity">0</CssParameter>
											<CssParameter name="stroke">#FF0000</CssParameter>
											<CssParameter name="stroke-width">0.3</CssParameter>
											<CssParameter name="stroke-dasharray">6 2 6 12</CssParameter>
										</Stroke>
									</Mark>
									<Size>6</Size>
									<Displacement>
										<DisplacementX>0</DisplacementX>
										<DisplacementY>0</DisplacementY>
									</Displacement>
                                  	<Rotation>180</Rotation>
								</Graphic>
							</GraphicStroke>
						</Stroke>
					</LineSymbolizer>
					<LineSymbolizer uom="http://www.opengeospatial.org/se/units/metre">
						<Stroke>
							<GraphicStroke>
								<Graphic>
									<Mark>
										<WellKnownName>ttf://DejaVu Sans#0x005f</WellKnownName>
										<Fill>
											<CssParameter name="fill">#FF0000</CssParameter>
										</Fill>
										<Stroke>
											<CssParameter name="stroke-opacity">0</CssParameter>
											<CssParameter name="stroke">#FF0000</CssParameter>
											<CssParameter name="stroke-width">0.3</CssParameter>
										</Stroke>
									</Mark>
									<Size>3</Size>
									<Displacement>
										<DisplacementX>0</DisplacementX>
										<DisplacementY>-3</DisplacementY>
									</Displacement>
                                  	<Rotation>0</Rotation>
								</Graphic>
							</GraphicStroke>
						</Stroke>
					</LineSymbolizer>                  
				</Rule>             
